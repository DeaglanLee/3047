SELECT b.basket_id,
b.user_id,
b.active,
b.created_at AS basket_created_at,
s.store_id,
s.name AS store_name,
i.item_id,
i.name AS item_name,
i.price,
i.picture,
i.nutrition,
bi.quantity,
i.price * bi.quantity::numeric AS item_total,
b.reserved_at
FROM baskets b
LEFT JOIN basket_items bi ON b.basket_id = bi.basket_id
LEFT JOIN items i ON bi.item_id = i.item_id
LEFT JOIN stores s ON i.store_id = s.store_id;