<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head'); %>
</head>

<body>
    <div class="page-container d-flex flex-column min-vh-100">
        <div class="bg-dark">
            <%- include('../partials/topnavbar') %>
        </div>

        <div class="content-container mx-5 mt-5 row">
            <div class="textcenter">
                <div class="">
                    <h1>Your Basket</h1>
                </div>
            </div>

            <div class="mt-3 mx-3">
                <!-- <img src="..." class="card-img-top" alt="..."> -->
                <% if(basket) { basket.forEach((item)=> { %>
                    <form action="/<%= item.basket_id %>/removeItemFromBasket/<%= item.item_id %>" method="POST">
                        <div class="card container-sm my-3">
                            <div class="card-body">
                                <h5 class="card-title">
                                    <%= item.item_name %>
                                </h5>
                                <p class="card-text">Some quick example text to build on the card title and make up the
                                    bulk of the card’s content.</p>
                                <div data-mdb-input-init class="form-outline d-flex flex-row mb-3"
                                    style="width: 10rem;">
                                    <label class="form-label me-2" for="itemQuantity">Quantity</label>
                                    <input placeholder="<%= item.quantity %>" id="itemQuantity"
                                        class="form-control" name="itemQuantity" readonly/>
                                </div>
                                <div class="mb-3">
                                    <div>Per item cost: £<%= item.price %></div>
                                    <div>Total cost: £<%= item.item_total %></div>
                                </div>

                                <button type="submit" class="btn btn-primary">Remove</button>
                            </div>
                        </div>
                    </form>
                    <% }); %>
                    <div class="mt-4 text-center">
                        <h4 class="mt-4">Review your order items above. Proceed to checkout when ready.</h4>
                        <form action="/checkout" method="GET">
                            <div class="card-body">
                                <p class="card-text"> Total amount: £<%= basketTotal %></p>
                                <button type="submit" class="btn btn-primary mt-3">Proceed to Checkout</button>
                            </div>
                        </form>
                    </div>
                    


                        <% } else { %>
                            <p class="container-sm text-center">Your basket is empty.</p>
                            <% } %>
            </div>

        </div>
    </div>
</body>