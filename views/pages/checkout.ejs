<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head'); %>
</head>

<body>
    <%- include('../partials/topnavbar'); %>

        <div class="content-container mx-5 mt-5 row">
            <div class="textcenter">
                <div class="">
                    <h1>
                        Checkout
                    </h1>
                </div>
            </div>

            <div class="mt-3 mx-3">
                <% if(basket && basket.length> 0) { basket.forEach((item)=> { %>
                    <div class="card container-sm">
                        <div class="card-body">
                            <h5 class="card-title">
                                <%= item.name %> x <%= item.quantity %>
                            </h5>
                            <div class="mb-3">
                                <div>Per item cost: £<%= item.price %>
                                </div>
                                <div>Total cost: £<%= (item.price * item.quantity).toFixed(2) %>
                                </div>
                            </div>

                        </div>
                    </div>
                    <% }); %>

                        <div class="container-sm">
                            <form action="/processPayment" method="POST">
                                <div class="form-group mt-3">
                                    <label for="inputCardNumber">Card Number</label>
                                    <input min="0000000000000000" max="9999999999999999" type="number" class="form-control" id="inputCardNumber"
                                        placeholder="0000000000000000" name="cardNumber" required>
                                </div>
                                <div class="form-group mt-3">
                                    <label for="inputNameOnCard">Name On Card</label>
                                    <input type="text" class="form-control" id="inputNameOnCard" placeholder="John Doe"
                                        name="nameOnCard" required>
                                </div>
                                <div class="form-group mt-3">
                                    <label for="inputExpiry">Expiry Date</label>
                                    <input type="date" class="form-control" id="inputExpiry" placeholder=""
                                        name="expirationDate" required>
                                </div>
                                <div class="form-group mt-3">
                                    <label for="inputAddress">Address</label>
                                    <input type="text" class="form-control" id="inputAddress"
                                        placeholder="123 Main Street" name="address" required>
                                </div>
                                <div class="form-group mt-3">
                                    <label for="inputPostCode">Postcode</label>
                                    <input type="text" class="form-control" id="inputPostCode" placeholder="BT1 5NA"
                                        name="postcode" required>
                                </div>
                                <div class="center">
                                    <button class="submit-button mt-3 rounded btn btn-primary" type="submit"
                                    class="btn btn-primary" value="process">Process Payment</button>
                                </div>
                                
                            </form>
                        </div>

                        <% } else { %>
                            <p class="container-sm text-center">Cannot checkout an empty basket</p>
                        <% } %>
            </div>
        </div>
</body>

<script>
</script>