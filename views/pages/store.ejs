<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head'); %>
</head>

<body>
    <div class="page-container d-flex flex-column min-vh-100">
        <div class="bg-dark">
            <%- include('../partials/topnavbar') %>
        </div>
        <div class="content-container mx-5 mt-5 row">
            <!-- Hidden store id -->
            <div hidden id="store-id" data-store-id="<%= store.store_id %>"></div>
            <div class="container-fluid d-flex justify-content-center align-items-center position-relative"
                style="height: 90px;">
                <h1 class="m-0">
                    <%= store.name %>
                </h1>
                <% if (user && !storeAdmin) { %>
                    <a href="/basket" class="btn btn-primary position-absolute top-50 end-0 translate-middle-y me-3">
                        Your Basket
                    </a>
                <% } %>
                <% if (storeAdmin) { %>
                    <a href="/store/<%= store.store_id %>/createItem" class="btn btn-primary position-absolute top-50 end-0 translate-middle-y me-3">
                        Create Item
                    </a> 
                <% } %>
            </div>

            <%- include('../partials/itemList', { includeStoreFilter: true, endpoint: {value: '/api/store-items' },
                filterStore: { value: store.store_id }, includeStoreSelector: false }) %>
        </div>
    </div>
</body>

</html>