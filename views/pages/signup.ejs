<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head'); %>
</head>

<body>
    <div class="page-container d-flex flex-column min-vh-100">
        <div class="bg-dark">
            <%- include('../partials/topnavbar') %>
        </div>
        <div id="container" class="mycontainer my-auto">
            <div id="loginbackground">
                <div class="signup-content">
                    <h3 class="signup-header center">Sign Up!</h3>
                    <form action="/signup" method="POST">
                        <div class="form-group mt-3">
                            <label for="inputEmail">Email</label>
                            <input type="email" class="form-control" id="inputEmail"
                                placeholder="Email" name="email" required>
                        </div>
                        <div class="form-group mt-3">
                            <label for="inputUsername">Username</label>
                            <input type="username" class="form-control" id="inputUsername"
                                placeholder="Username" name="username" required>
                        </div>
                        <div class="form-group mt-3">
                            <label for="inputPassword">Password</label>
                            <input type="password" class="form-control" id="inputPassword"
                                placeholder="Password" name="password" required>
                        </div>
                        <div class="d-grid gap-2 col-4 mx-auto">
                            <button class="submit-button mt-3 rounded btn btn-primary" type="submit"
                                class="btn btn-primary" value="process">Sign Up!</button>
                        </div>
                        <div class="center mt-4">
                            <p class="">Already have an account? <a class="link-underline link-underline-opacity-0 text-body custom" href="/login">Log
                                In!</a></p>
                            <p class="">Need a Store account? <a class="link-underline link-underline-opacity-0 text-body custom" href="/registerstore">Register Here!</a></p>
                        </div>
                    </form>
                    <div class="center mt-3">
                        <% if (error) { %>
                            <p class="text-danger"><%= error %></p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>

</html>
<script>
</script>