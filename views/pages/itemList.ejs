<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head'); %>
</head>

<body>
    <div class="page-container d-flex flex-column min-vh-100">
        <div class="bg-dark">
            <%- include('../partials/topnavbar') %>
        </div>
        <div class="content-container mx-5 mt-5 row">
            <div class="container-fluid d-flex justify-content-center align-items-center position-relative"
                style="height: 90px;">
                <h1 class="m-0">All Items</h1>
            </div>
            <div class="filter flex">
                <h4>Filter by Nutrition</h4>
                <div class="d-flex mb-3">
                    <div class="filter-fat me-4">
                        <label for="filter-fat" class="form-label">Fat</label>
                        <input type="range" class="form-range" id="filter-fat"
                            placeholder="3" name="fat" min="0" max="10">
                        <output for="filter-fat" id="range-fat" aria-hidden="true"></output>
                    </div>
                    <div class="filter-carbs me-4">
                        <label for="filter-carbs" class="form-label">Carbs</label>
                        <input type="range" class="form-range" id="filter-carbs"
                            placeholder="3" name="carbs" min="0" max="10">
                        <output for="filter-carbs" id="range-carbs" aria-hidden="true"></output>
                    </div>
                    <div class="filter-sugar me-4">
                        <label for="filter-sugar" class="form-label">Sugar</label>
                        <input type="range" class="form-range" id="filter-sugar"
                            placeholder="3" name="sugar" min="0" max="10">
                        <output for="filter-sugar" id="range-sugar" aria-hidden="true"></output>
                    </div>
                    <div class="filter-protein me-4">
                        <label for="filter-protein" class="form-label">Protein</label>
                        <input type="range" class="form-range" id="filter-protein"
                            placeholder="3" name="protein" min="0" max="10">
                        <output for="filter-protein" id="range-protein" aria-hidden="true"></output>
                    </div>
                    <div class="filter-store me-4">
                        <label for="filter-store" class="form-label">Store</label>
                        <select class="form-select" id="filter-store" name="store">
                            <option value="">All Stores</option>
                            <% stores.forEach(store => { %>
                                <option value="<%= store.store_id %>"><%= store.name %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
            
            <%- include('../partials/items') %>
            </div>
        </div>
    <div>
</body>

<script>
    window.currentUser = <%- JSON.stringify(user || null) %>;
    window.owner = <%- JSON.stringify(owner || null) %>;
    console.log("Current User:", window.currentUser);
    console.log("Owner:", window.owner);
</script>

<script type="module">
    import { itemCardHtml } from '/js/filtering/filter.js';

    // Filter values
    // Fat
    const rangeFat = document.getElementById('filter-fat');
    const rangeOutputFat = document.getElementById('range-fat');

    rangeOutputFat.textContent = rangeFat.value;

    rangeFat.addEventListener('input', function() {
        rangeOutputFat.textContent = this.value;
        testFetch();
    });

    // Carbs
    const rangeCarbs = document.getElementById('filter-carbs');
    const rangeOutputCarbs = document.getElementById('range-carbs');

    rangeOutputCarbs.textContent = rangeCarbs.value;

    rangeCarbs.addEventListener('input', function() {
        rangeOutputCarbs.textContent = this.value;
        testFetch();
    });

    // Protein
    const rangeProtein = document.getElementById('filter-protein');
    const rangeOutputProtein = document.getElementById('range-protein');

    rangeOutputProtein.textContent = rangeProtein.value;

    rangeProtein.addEventListener('input', function() {
        rangeOutputProtein.textContent = this.value;
        testFetch();
    });

    // Sugar
    const rangeSugar = document.getElementById('filter-sugar'); 
    const rangeOutputSugar = document.getElementById('range-sugar');

    rangeOutputSugar.textContent = rangeSugar.value;

    rangeSugar.addEventListener('input', function() {
        rangeOutputSugar.textContent = this.value;
        testFetch();
    });

    // store filter
    const filterStore = document.getElementById('filter-store');
    filterStore.addEventListener('change', function() {
        testFetch();
    }); 




    function render(items) {
        const container = document.querySelector('.row.row-cols-1.row-cols-md-3.g-4');
        container.innerHTML = '';

        items.forEach(item => {
            const card = document.createElement('div');
            card.className = 'col';
            card.innerHTML = itemCardHtml(item, window.currentUser, window.owner);
            container.appendChild(card);
        });
    }



    async function testFetch() {
    const params = new URLSearchParams({
        fat: rangeOutputFat.textContent,
        carbs: rangeOutputCarbs.textContent,
        sugar: rangeOutputSugar.textContent,
        protein: rangeOutputProtein.textContent,
        store: filterStore.value
    });

    const res = await fetch(`/api/items?${params.toString()}`);
    const data = await res.json();

    render(data);

    console.log("Response:", data);
    }
</script>


</html>