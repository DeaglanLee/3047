<div class="filter flex">
    <h4>Filter by Nutrition</h4>
    <div class="d-flex mb-3">
        <div class="filter-fat me-4">
            <label for="filter-fat" class="form-label">Fat</label>
            <input type="range" class="form-range" id="filter-fat" placeholder="3" name="fat" min="0" max="10">
            <output for="filter-fat" id="range-fat" aria-hidden="true"></output>
        </div>
        <div class="filter-saturates me-4">
            <label for="filter-saturates" class="form-label">Saturates</label>
            <input type="range" class="form-range" id="filter-saturates" placeholder="3" name="saturates" min="0"
                max="10">
            <output for="filter-saturates" id="range-saturates" aria-hidden="true"></output>
        </div>
        <div class="filter-sugar me-4">
            <label for="filter-sugar" class="form-label">Sugar</label>
            <input type="range" class="form-range" id="filter-sugar" placeholder="3" name="sugar" min="0" max="10">
            <output for="filter-sugar" id="range-sugar" aria-hidden="true"></output>
        </div>
        <div class="filter-salt me-4">
            <label for="filter-salt" class="form-label">salt</label>
            <input type="range" class="form-range" id="filter-salt" placeholder="3" name="salt" min="0" max="10">
            <output for="filter-salt" id="range-salt" aria-hidden="true"></output>
        </div>
        <div class="filter-protein me-4">
            <label for="filter-protein" class="form-label">Protein</label>
            <input type="range" class="form-range" id="filter-protein" placeholder="3" name="protein" min="0" max="10">
            <output for="filter-protein" id="range-protein" aria-hidden="true"></output>
        </div>

        <% if (includeStoreSelector) { %>
            <div class="filter-store me-4">
                <label for="filter-store" class="form-label">Store</label>
                <select class="form-select" id="filter-store" name="store">
                    <option value="">All Stores</option>
                    <% stores.forEach(store=> { %>
                        <option value="<%= store.store_id %>">
                            <%= store.name %>
                        </option>
                        <% }) %>
                </select>
            </div>
        <% } %>

    </div>

    <!-- list of cards -->
    <div class="row row-cols-1 row-cols-md-3 g-4"></div>
</div>

<script>
        window.currentUser = <%= (user || null) %>;
        window.storeAdmin = <%= (!!storeAdmin) %>;
        window.filterStore = {"value": "<%= (filterStore.value || null) %>"};
</script>

<script>
  function reserveItem(itemId) {
    fetch('/reserveItem/' + itemId, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({})
    })
  }
</script>

<script type="module">
    <%- include('../helpers/itemCard') %>

    window.addEventListener('DOMContentLoaded', () => {
        renderItemList();
    });

    // Filter values
    // Fat
    const rangeFat = document.getElementById('filter-fat');
    const rangeOutputFat = document.getElementById('range-fat');

    rangeOutputFat.textContent = rangeFat.value;

    rangeFat.addEventListener('input', function () {
        rangeOutputFat.textContent = this.value;
        renderItemList();
    });

    // Saturates
    const rangeSaturates = document.getElementById('filter-saturates');
    const rangeOutputSaturates = document.getElementById('range-saturates');

    rangeOutputSaturates.textContent = rangeSaturates.value;

    rangeSaturates.addEventListener('input', function () {
        rangeOutputSaturates.textContent = this.value;
        renderItemList();
    });

    // Sugar
    const rangeSugar = document.getElementById('filter-sugar');
    const rangeOutputSugar = document.getElementById('range-sugar');

    rangeOutputSugar.textContent = rangeSugar.value;

    rangeSugar.addEventListener('input', function () {
        rangeOutputSugar.textContent = this.value;
        renderItemList();
    });

    // Salt
    const rangeSalt = document.getElementById('filter-salt');
    const rangeOutputSalt = document.getElementById('range-salt');

    rangeOutputSalt.textContent = rangeSalt.value;

    rangeSalt.addEventListener('input', function () {
        rangeOutputSalt.textContent = this.value;
        renderItemList();
    });

    // Protein
    const rangeProtein = document.getElementById('filter-protein');
    const rangeOutputProtein = document.getElementById('range-protein');

    rangeOutputProtein.textContent = rangeProtein.value;

    rangeProtein.addEventListener('input', function () {
        rangeOutputProtein.textContent = this.value;
        renderItemList();
    });

    let filterStore = {"value": "<%= (filterStore.value || null) %>"};
    <% if (includeStoreSelector) { %>
    // store filter
    filterStore = document.getElementById('filter-store');
    filterStore.addEventListener('change', function () {
        renderItemList();
    });

    <% } %>



    function render(items) {
        const container = document.querySelector('.row.row-cols-1.row-cols-md-3.g-4');
        container.innerHTML = '';

        items.forEach(item => {
            const card = document.createElement('div');
            card.className = 'col';
            card.innerHTML = itemCardHtml(item, true, window.owner);
            container.appendChild(card);
        });
    }



    async function renderItemList() {
        const params = new URLSearchParams({
            fat: rangeOutputFat.textContent,
            saturates: rangeOutputSaturates.textContent,
            sugar: rangeOutputSugar.textContent,
            salt: rangeOutputSalt.textContent,
            protein: rangeOutputProtein.textContent,
            <% if (includeStoreFilter) { %>
            store: filterStore.value
            <% } %>
        });
        console.log("Params:", params);
        const res = await fetch(`/api/items?${params.toString()}`);
        const data = await res.json();

        render(data);

        console.log("Response:", data);
    }

    console.log("itemList.ejs loaded");
</script>
