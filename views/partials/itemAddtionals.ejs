<% if (owner) { %>
        <div class="col">
          <div class="card h-100">
            <img class="card-img-top" src="<%= baseUrl %>/img/stores/items/DefaultItem.png" alt=""
              style="height: 300px;">
            <div class="card-body">
              <h5 class="card-title">
                Create an Item
              </h5>
              <p class="card-text">
                Create a new item to display here.
              </p>
              <a href="/store/<%= store.store_id %>/createItem" class="btn btn-primary">Create Item</a>
            </div>
          </div>
        </div>
        <% } %>
          <% } else { %>
            <div class="col">
              <div class="card h-100">
                <img class="card-img-top" src="<%= baseUrl %>/img/stores/items/DefaultItem.png" alt=""
                  style="height: 300px;">
                <div class="card-body">
                  <h5 class="card-title">
                    No Items Available
                  </h5>
                  <p class="card-text">
                    No Items have been added to this store yet.
                  </p>
                  <% if (owner) { %>
                    <a href="/store/<%= store.store_id %>/createItem" class="btn btn-primary">Add Item</a>
                    <% } %>
                </div>
              </div>
            </div>
            <% } %>