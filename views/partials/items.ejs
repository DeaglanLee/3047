<div class="row row-cols-1 row-cols-md-3 g-4">
  <% if(typeof items !=='undefined' ) { items.forEach((item)=> { %>
    <div class="col">
      <div class="card h-100">
        <% if(item.picture !==null ) { %>
          <img class="card-img-top" src="<%= baseUrl %>/img/stores/items/<%= item.picture %>" alt=""
            style="height: 300px;">
          <% } else { %>
            <img class="card-img-top" src="<%= baseUrl %>/img/stores/items/DefaultItem.png" alt=""
              style="height: 300px;">
            <% } %>
              <div class="card-body">
                <form action="/addItemToBasket/<%= item.item_id %>" method="POST">
                  <h5 class="card-title">
                    <%= item.name %>
                  </h5>
                  <p class="card-text" name="itemPrice">
                    <%= item.price %>
                  </p>
                  <div data-mdb-input-init class="form-outline d-flex flex-row mb-3" style="width: 10rem;">
                    <label class="form-label me-2" for="itemQuantity">Quantity</label>
                    <input min="1" max="10" placeholder="1" type="number" id="itemQuantity" class="form-control" name="itemQuantity" />
                  </div>
                  <% if (user) { %>
                    <button type="submit" class="btn btn-primary">Add to Basket</button>
                  <% } %>
                </form>
              </div>
              <div class="card-footer">
                <small class="text-body-secondary">
                  <%= item.updated_at %>
                </small>
              </div>
      </div>
    </div>
    <% }); %>
      <% if (owner) { %>
        <div class="col">
          <div class="card h-100">
            <img class="card-img-top" src="<%= baseUrl %>/img/stores/items/DefaultItem.png" alt=""
              style="height: 300px;">
            <div class="card-body">
              <h5 class="card-title">
                Create an Item
              </h5>
              <p class="card-text">
                Create a new item to display here.
              </p>
              <a href="/createItem" class="btn btn-primary">Create Item</a>
            </div>
          </div>
        </div>
        <% } %>
          <% } else { %>
            <div class="col">
              <div class="card h-100">
                <img class="card-img-top" src="<%= baseUrl %>/img/stores/items/DefaultItem.png" alt=""
                  style="height: 300px;">
                <div class="card-body">
                  <h5 class="card-title">
                    No Items Available
                  </h5>
                  <p class="card-text">
                    No Items have been added to this store yet.
                  </p>
                  <% if (owner) { %>
                    <a href="/store/<%= store.store_id %>/createItem" class="btn btn-primary">Add Item</a>
                    <% } %>
                </div>
              </div>
            </div>
            <% } %>
</div>




