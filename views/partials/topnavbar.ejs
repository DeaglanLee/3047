<div class="py-2 mb-2 bg-dark navbar-size-y screen">
  <nav class="navbar navbar-expand-lg">
    <div class="container-fluid">
      <a class="navbar-brand text-white" href="/">BitMunch</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item">
            <a class="nav-link active text-white" href="/stores">Stores</a>
          </li>
          <% if (!user) { %>
          <li class="nav-item">
            <a class="nav-link text-white" href="/registerstore">Register Store</a>
          </li>
          <% } %>
          <% if (!storeAdmin) { %>
          <li class="nav-item">
            <a class="nav-link text-white" href="/items">Items</a>
          </li>
          <% } %>
          <% if (storeAdmin) { %>
           <li class="nav-item">
            <a class="nav-link text-white" href="/store-items">Store Items</a>
          </li>
          <% } %>
        </ul>
        <ul class="navbar-nav mb-2 mb-lg-0">
          <% if (user && !storeAdmin) { %>
          <li class="nav-item">
            <a class="nav-link text-white" href="/basket">Basket</a>
          </li>
          <% } %>
          <% if (user) { %>
          <ul class="navbar-nav end mb-2 mb-lg-0">
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle text-white pl-2" id="navbarDarkDropdownMenuLink" href="#"
                role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <%= user.username %>
              </a>
              <ul class="dropdown-menu bg-dark max-width" style = "right: 0" aria-labelledby="navbarDarkDropdownMenuLink">
                <li><a class="dropdown-item text-white" href="/profile/<%= user.user_id %>">Dashboard</a></li>
                <li><a class="dropdown-item text-white" href="/logout">LogOut</a></li>
              </ul>
            </li>
          </ul>
          <% } else { %>
            <li class="nav-item">
              <a class="nav-link text-white" href="/login">Sign Up/Log In</a>
            </li>
            <% } %>
        </ul>
      </div>
    </div>
  </nav>
</div>